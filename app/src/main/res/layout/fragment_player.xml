<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ================== LIBRARY (MAIN VIEW) ================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/libraryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Library Header -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/libraryHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:paddingBottom="10dp"
            android:text="Your Library"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Material 3 Search Bar (Compact) -->
        <com.google.android.material.search.SearchBar
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:hint="@string/search_songs_hint"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/libraryHeader" />

        <!-- M3 Expressive Connected Button Group (Title Case & Small Text) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sortButtonGroup"
            style="@style/Widget.Material3Expressive.MaterialButtonGroup.Connected"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:spacing="2dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
            app:innerCornerSize="8dp"
            app:layout_constraintTop_toBottomOf="@id/searchBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortAZ"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:lines="1"
                android:ellipsize="end"
                android:text="A to Z"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:letterSpacing="0.02"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortRecent"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:lines="1"
                android:ellipsize="end"
                android:text="Recent"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:letterSpacing="0.02"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortArtist"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:lines="1"
                android:ellipsize="end"
                android:text="Artist"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:letterSpacing="0.02"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortFavorites"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:lines="1"
                android:ellipsize="end"
                android:text="Favorites"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:letterSpacing="0.02"
                android:checkable="true" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Refreshing Card with Large Contained LoadingIndicator -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRefreshing"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/sortButtonGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/loadingIndicator"
                style="@style/Widget.Material3.LoadingIndicator.Contained"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="12dp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Barrier to push RecyclerView down when refresh card is visible -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="sortButtonGroup,cardRefreshing" />

        <!-- SwipeRefreshLayout for pull detection -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierRefresh">

            <!-- Song Library RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSongLibrary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="160dp"
                tools:itemCount="10"
                tools:listitem="@layout/item_library_song" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- A-Z Fast Scroll Bar -->
        <com.codetrio.spatialflow.ui.custom.VerticalLetterBar
            android:id="@+id/letterBar"
            android:layout_width="24dp"
            android:layout_height="0dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="180dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/barrierRefresh"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Material 3 Search View (anchored to SearchBar) -->
    <com.google.android.material.search.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="@string/search_songs_hint"
        app:layout_anchor="@id/searchBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="15dp"
            android:paddingBottom="16dp" />

    </com.google.android.material.search.SearchView>

    <!-- ================== CONSOLIDATED PLAYER BOTTOM SHEET ================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="12dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Shared Background (Dynamic Mesh Blobs) -->
            <com.codetrio.spatialflow.ui.custom.AnimatedMeshGradientView
                android:id="@+id/gradientBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- ================== FULL PLAYER CONTENT ================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fullPlayerContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp"
                android:alpha="0">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Now Playing"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Album Art -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvNowPlaying"
                    app:layout_constraintBottom_toTopOf="@id/songInfoContainer"
                    app:layout_constraintVertical_chainStyle="packed"
                    app:layout_constraintWidth_max="360dp"
                    app:strokeWidth="0dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:id="@+id/ivAlbumArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_album_art"
                        android:contentDescription="Album Art" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Song Info Section -->
                <LinearLayout
                    android:id="@+id/songInfoContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardAlbumArt"
                    app:layout_constraintBottom_toTopOf="@id/chipSongHaptics">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvSongName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:gravity="center"
                        android:text="Song Title"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvArtistName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.7"
                        android:gravity="center"
                        android:text="Artist Name"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSongHaptics"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    
                    android:text="Music Haptics"
                    android:checkable="true"
                    android:gravity="center"
                    
                    app:chipBackgroundColor="#4DFFFFFF"
                    app:chipSurfaceColor="@android:color/transparent"

                    app:chipCornerRadius="5dp"
                    
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    
                    app:chipIcon="@drawable/ic_haptic"
                    app:chipIconVisible="false"
                    app:checkedIconVisible="false"
                    app:checkedIconTint="@android:color/white"
                    app:chipIconTint="@android:color/white"
                    app:chipIconSize="18dp"
                    
                    app:rippleColor="#1AFFFFFF"
                    app:chipStrokeWidth="0dp"
                    
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="5dp"
                    android:paddingTop="5dp"
                    android:layout_marginBottom="12dp"
                    
                    app:layout_constraintBottom_toTopOf="@id/seekBar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>






                <!-- Progress Head Indicator (Seek Thumb Style) -->
                <View
                    android:id="@+id/progressHeadIndicator"
                    android:layout_width="4dp"
                    android:layout_height="30dp"
                    android:elevation="4dp"
                    android:background="@drawable/progress_thumb"
                    app:layout_constraintStart_toStartOf="@id/waveProgress"
                    app:layout_constraintTop_toTopOf="@id/waveProgress"
                    app:layout_constraintBottom_toBottomOf="@id/waveProgress"/>

                <!-- WAVY PROGRESS INDICATOR -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/waveProgress"
                    style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:max="1000"
                    app:indicatorColor="@android:color/white"
                    app:trackColor="#4DFFFFFF"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="6dp"
                    app:wavelength="80dp"
                    app:waveAmplitude="4dp"
                    app:layout_constraintTop_toBottomOf="@id/chipSongHaptics"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- SEEKBAR (HIDDEN) -->
                <com.google.android.material.slider.Slider
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:value="0"
                    android:alpha="0"
                    app:labelBehavior="gone"
                    app:thumbRadius="8dp"
                    app:trackHeight="8dp"
                    app:layout_constraintTop_toTopOf="@id/waveProgress"
                    app:layout_constraintBottom_toBottomOf="@id/waveProgress"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="0:00"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="@id/waveProgress"
                    app:layout_constraintTop_toBottomOf="@id/waveProgress"
                    app:layout_constraintBottom_toTopOf="@id/mainControls"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.6"
                    android:text="4:20"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="@id/waveProgress"
                    app:layout_constraintTop_toBottomOf="@id/waveProgress"
                    android:layout_marginTop="4dp" />

                <!-- Main Controls -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mainControls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tvCurrentTime"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrevious"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:contentDescription="Previous"
                        app:backgroundTint="#33FFFFFF"
                        app:icon="@drawable/ic_skip_previous"
                        app:iconSize="32dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@android:color/white"
                        app:strokeWidth="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnPlayPauseToggle"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayPauseToggle"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginHorizontal="24dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:contentDescription="Play Pause"
                        app:backgroundTint="@android:color/white"
                        app:icon="@drawable/ic_play"
                        app:iconSize="40dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@android:color/black"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnNext"
                        app:layout_constraintStart_toEndOf="@id/btnPrevious"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNext"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:contentDescription="Next"
                        app:backgroundTint="#33FFFFFF"
                        app:icon="@drawable/ic_skip_next"
                        app:iconSize="32dp"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@android:color/white"
                        app:strokeWidth="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/btnPlayPauseToggle"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Secondary Action Bar -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/secondaryControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#4D6677"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/mainControls"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShuffle"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:contentDescription="Shuffle"
                            app:icon="@drawable/ic_shuffle"
                            app:iconSize="22dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRepeat"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginHorizontal="8dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:contentDescription="Repeat"
                            app:icon="@drawable/ic_repeat"
                            app:iconSize="22dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFavorite"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:contentDescription="Favorite"
                            app:icon="@drawable/ic_favorite_border"
                            app:iconSize="22dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================== MINI PLAYER CONTENT (CAPSULE) ================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/miniPlayerContent"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="top"
                android:paddingHorizontal="12dp">

                <!-- Mini Progress Bar -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/miniProgress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="1000"
                    app:indicatorColor="@color/white"
                    app:trackColor="@color/white_20"
                    app:trackThickness="4dp"
                    app:trackCornerRadius="2dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMiniAlbumArt"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Album Art"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_album_art"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/miniProgress"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvMiniSongName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/no_song_selected"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tvMiniArtistName"
                    app:layout_constraintEnd_toStartOf="@+id/btnMiniPrevious"
                    app:layout_constraintStart_toEndOf="@id/ivMiniAlbumArt"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt"
                    app:layout_constraintVertical_chainStyle="packed" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvMiniArtistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown Artist"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toEndOf="@id/tvMiniSongName"
                    app:layout_constraintStart_toStartOf="@id/tvMiniSongName"
                    app:layout_constraintTop_toBottomOf="@id/tvMiniSongName" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniPrevious"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Previous"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toStartOf="@+id/btnMiniPlayPause"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniPlayPause"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Play Pause"
                    app:backgroundTint="?attr/colorPrimary"
                    app:icon="@drawable/ic_play"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toStartOf="@+id/btnMiniNext"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniNext"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Next"
                    app:icon="@drawable/ic_skip_next"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>