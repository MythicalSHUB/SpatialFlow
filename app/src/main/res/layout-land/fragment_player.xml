<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- ================== LIBRARY (MAIN VIEW) ================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/libraryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Library Header -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/libraryHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Your Library"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvLibrarySongCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvLibrarySongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="0 songs"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBaseline_toBaselineOf="@id/libraryHeader"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Song Library RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSongLibrary"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/libraryHeader"
            tools:itemCount="10"
            tools:listitem="@layout/item_library_song" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================== CONSOLIDATED PLAYER BOTTOM SHEET ================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="12dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Shared Background (Dynamic Mesh Blobs) -->
            <com.codetrio.spatialflow.ui.custom.AnimatedMeshGradientView
                android:id="@+id/gradientBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- ================== FULL PLAYER CONTENT (LANDSCAPE - MUST BE ConstraintLayout) ================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fullPlayerContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp">

                <!-- LEFT HALF: Album Art -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="24dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.35">

                    <ImageView
                        android:id="@+id/ivAlbumArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_album_art"
                        android:contentDescription="Album Art" />
                </com.google.android.material.card.MaterialCardView>

                <!-- RIGHT HALF: Controls -->
                <!-- Now Playing Header -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvNowPlaying"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="Now Playing"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardAlbumArt"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Song Info -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvSongName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="Song Title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/tvNowPlaying"
                    app:layout_constraintStart_toStartOf="@id/tvNowPlaying"
                    app:layout_constraintTop_toBottomOf="@id/tvNowPlaying" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvArtistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.7"
                    android:text="Artist Name"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@android:color/white"
                    app:layout_constraintEnd_toEndOf="@id/tvSongName"
                    app:layout_constraintStart_toStartOf="@id/tvSongName"
                    app:layout_constraintTop_toBottomOf="@id/tvSongName" />

                <!-- Haptics Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSongHaptics"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Music Haptics"
                    android:textColor="@android:color/white"
                    app:checkedIcon="@drawable/ic_check"
                    app:checkedIconTint="@android:color/white"
                    app:chipBackgroundColor="#33FFFFFF"
                    app:chipIcon="@drawable/ic_vibration"
                    app:chipIconTint="@android:color/white"
                    app:chipStrokeWidth="0dp"
                    app:layout_constraintStart_toStartOf="@id/tvArtistName"
                    app:layout_constraintTop_toBottomOf="@id/tvArtistName" />

                <!-- Progress (Wavy) -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/waveProgress"
                    style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceVariant"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="6dp"
                    app:waveAmplitude="2dp"
                    app:wavelength="60dp"
                    app:layout_constraintEnd_toEndOf="@id/tvNowPlaying"
                    app:layout_constraintStart_toStartOf="@id/tvNowPlaying"
                    app:layout_constraintTop_toBottomOf="@id/chipSongHaptics" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:alpha="0"
                    android:value="0"
                    android:valueFrom="0"
                    android:valueTo="100"
                    app:labelBehavior="gone"
                    app:thumbRadius="6dp"
                    app:trackHeight="6dp"
                    app:layout_constraintBottom_toBottomOf="@id/waveProgress"
                    app:layout_constraintEnd_toEndOf="@id/waveProgress"
                    app:layout_constraintStart_toStartOf="@id/waveProgress"
                    app:layout_constraintTop_toTopOf="@id/waveProgress" />

                <!-- Time Labels -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="00:00"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintStart_toStartOf="@id/waveProgress"
                    app:layout_constraintTop_toBottomOf="@id/waveProgress" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="00:00"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintEnd_toEndOf="@id/waveProgress"
                    app:layout_constraintTop_toBottomOf="@id/waveProgress" />

                <!-- Main Controls -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevious"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.8"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Previous"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconSize="24dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnPlayPauseToggle"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="@id/tvNowPlaying" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPauseToggle"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginHorizontal="16dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Play Pause"
                    app:backgroundTint="@android:color/white"
                    app:icon="@drawable/ic_play"
                    app:iconSize="32dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@android:color/black"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnNext"
                    app:layout_constraintStart_toEndOf="@id/btnPrevious" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:alpha="0.8"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:contentDescription="Next"
                    app:icon="@drawable/ic_skip_next"
                    app:iconSize="24dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/secondaryControls"
                    app:layout_constraintStart_toEndOf="@id/btnPlayPauseToggle" />

                <!-- Secondary Controls -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/secondaryControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    app:cardBackgroundColor="#4D6677"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/tvNowPlaying"
                    app:layout_constraintStart_toEndOf="@id/btnNext">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShuffle"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:contentDescription="Shuffle"
                            app:icon="@drawable/ic_shuffle"
                            app:iconSize="18dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRepeat"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="4dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:contentDescription="Repeat"
                            app:icon="@drawable/ic_repeat"
                            app:iconSize="18dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFavorite"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:contentDescription="Favorite"
                            app:icon="@drawable/ic_favorite_border"
                            app:iconSize="18dp"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@android:color/white" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ================== MINI PLAYER CONTENT (CAPSULE) ================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/miniPlayerContent"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="top"
                android:paddingHorizontal="12dp">

                <!-- Mini Progress Bar -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/miniProgress"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:max="1000"
                    app:indicatorColor="@color/white"
                    app:trackColor="@color/white_20"
                    app:trackThickness="4dp"
                    app:trackCornerRadius="2dp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMiniAlbumArt"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:contentDescription="Album Art"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_album_art"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/miniProgress"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvMiniSongName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="@string/no_song_selected"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tvMiniArtistName"
                    app:layout_constraintEnd_toStartOf="@+id/btnMiniPrevious"
                    app:layout_constraintStart_toEndOf="@id/ivMiniAlbumArt"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt"
                    app:layout_constraintVertical_chainStyle="packed" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvMiniArtistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown Artist"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toEndOf="@id/tvMiniSongName"
                    app:layout_constraintStart_toStartOf="@id/tvMiniSongName"
                    app:layout_constraintTop_toBottomOf="@id/tvMiniSongName" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniPrevious"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Previous"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toStartOf="@+id/btnMiniPlayPause"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniPlayPause"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="2dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Play Pause"
                    app:backgroundTint="?attr/colorPrimary"
                    app:icon="@drawable/ic_play"
                    app:iconSize="26dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toStartOf="@+id/btnMiniNext"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMiniNext"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:contentDescription="Next"
                    app:icon="@drawable/ic_skip_next"
                    app:iconSize="22dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@id/ivMiniAlbumArt"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivMiniAlbumArt" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>