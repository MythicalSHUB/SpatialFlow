<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Portrait Toolbar Title -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/outfit</item>

    </style>
    <style name="Base.Theme.SpatialFlow" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/md_theme_primary</item>

        <!-- System bars styling -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
    <!-- Add this line -->
    <item name="linearProgressIndicatorStyle">@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy</item>
    </style>
    <!-- Landscape Toolbar Title - Smaller -->
    <style name="ToolbarTitleStyleLandscape" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="fontFamily">@font/outfit</item>
    </style>
    <style name="ShapeAppearance.SpatialFlow.CircleButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


        <style name="BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
            <item name="android:color">?attr/colorSecondaryContainer</item>
            <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
            <item name="android:width">64dp</item>
            <item name="android:height">32dp</item>
        </style>

    <style name="AppModalStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="ShapeAppearance.SpatialFlow.BottomSheet" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ============================================ -->
    <!-- Material 3 Expressive Typography Styles -->
    <!-- ============================================ -->

    <!-- Display Styles - For large, impactful text -->
    <style name="TextAppearance.SpatialFlow.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">57sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.SpatialFlow.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">45sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.SpatialFlow.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">36sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Headline Styles - For section titles -->
    <style name="TextAppearance.SpatialFlow.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SpatialFlow.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SpatialFlow.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Title Styles - For component headers -->
    <style name="TextAppearance.SpatialFlow.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.SpatialFlow.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.SpatialFlow.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Body Styles - For main content text -->
    <style name="TextAppearance.SpatialFlow.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="TextAppearance.SpatialFlow.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.SpatialFlow.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- Label Styles - For buttons, chips, and small labels -->
    <style name="TextAppearance.SpatialFlow.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.SpatialFlow.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.SpatialFlow.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/outfit</item>
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- ============================================ -->
    <!-- Connected Button Group Styles (M3 Expressive) -->
    <!-- ============================================ -->
    
    <!-- Shape for first button (rounded left, straight right) -->
    <style name="ShapeAppearance.SpatialFlow.ConnectedButton.Start" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeTopRight">4dp</item>
        <item name="cornerSizeBottomRight">4dp</item>
    </style>

    <!-- Shape for middle buttons (straight all sides) -->
    <style name="ShapeAppearance.SpatialFlow.ConnectedButton.Middle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <!-- Shape for last button (straight left, rounded right) -->
    <style name="ShapeAppearance.SpatialFlow.ConnectedButton.End" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">4dp</item>
        <item name="cornerSizeBottomLeft">4dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>

    <!-- Base Connected Button style -->
    <style name="Widget.SpatialFlow.ConnectedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- First button -->
    <style name="Widget.SpatialFlow.ConnectedButton.Start" parent="Widget.SpatialFlow.ConnectedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.SpatialFlow.ConnectedButton.Start</item>
    </style>

    <!-- Middle button -->
    <style name="Widget.SpatialFlow.ConnectedButton.Middle" parent="Widget.SpatialFlow.ConnectedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.SpatialFlow.ConnectedButton.Middle</item>
    </style>

    <!-- Last button -->
    <style name="Widget.SpatialFlow.ConnectedButton.End" parent="Widget.SpatialFlow.ConnectedButton">
        <item name="shapeAppearance">@style/ShapeAppearance.SpatialFlow.ConnectedButton.End</item>
    </style>
</resources>
